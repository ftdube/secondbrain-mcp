GIT_REPO_URL=git@github.com:youruser/your-vault.git
GIT_BRANCH=main
SSH_KEY_PATH=~/.ssh/id_ed25519
# Note: If GITSYNC_SSH_KEY_PATH is missing or the file doesn't exist, Docker will silently mount an empty directory and git-sync will crash.
GITSYNC_SSH_KEY_PATH=~/.ssh/git_sync_ed25519
VAULT_PATH=./vault-sample
